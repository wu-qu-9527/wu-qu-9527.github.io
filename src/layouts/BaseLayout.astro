---
interface Props {
  title: string;
  description?: string;
  immersive?: boolean;
}

import '../styles/global.css';

const { title, description = '无趣的个人博客', immersive = false } = Astro.props;
const path = Astro.url.pathname;
const navigation = [{href:'/',label:'首页'}, {href:'/articles/',label:'文章'}, {href:'/topics/',label:'专题'}, {href:'/about/',label:'关于'}];
const pageTitle = title === '首页' ? '无趣' : `${title} | 无趣`;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#151412" />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/jpeg" href="/img/avator.jpg" />
  </head>
  <body class:list={['min-h-screen antialiased', {immersive}]}>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="/">
          <img src="/img/avator.jpg" alt="无趣" />
          <span>无趣</span>
        </a>
        <nav aria-label="主导航">
          {navigation.map(item => <a href={item.href} aria-current={(item.href === '/' ? path === '/' : path.startsWith(item.href)) ? 'page' : undefined}>{item.label}</a>)}
        </nav>
      </header>
      <main id="main-content"><slot /></main>
      <footer class="site-footer">
        <span>© {new Date().getFullYear()} 无趣</span>
        <span>用 Astro 静态生成</span>
      </footer>
    </div>
  </body>
</html>
