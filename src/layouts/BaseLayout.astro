---
interface Props {
  title: string;
  description?: string;
}

import '../styles/global.css';

const { title, description = '人不如狗的个人博客' } = Astro.props;
const pageTitle = title === '首页' ? '人不如狗' : `${title} | 人不如狗`;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f5f1" />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/jpeg" href="/img/avator.jpg" />
  </head>
  <body class="min-h-screen antialiased">
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="/">
          <img src="/img/avator.jpg" alt="人不如狗" />
          <span>人不如狗</span>
        </a>
        <nav aria-label="主导航">
          <a href="/">文章</a>
          <a href="/about/">关于</a>
        </nav>
      </header>
      <main><slot /></main>
      <footer class="site-footer">
        <span>© {new Date().getFullYear()} 人不如狗</span>
        <span>用 Astro 静态生成</span>
      </footer>
    </div>
  </body>
</html>
