---
interface Props { title: string; kicker: string; count: string; label: string; link: string; linkLabel: string; }
const { title, kicker, count, label, link, linkLabel } = Astro.props;
---
<section class="collection-index" aria-label={title}>
  <header class="index-heading">
    <p class="index-kicker">{kicker}</p>
    <p class="index-count">{count}</p>
  </header>
  <div class="index-toolbar"><span>{label}</span><a href={link}>{linkLabel} ↗</a></div>
  <div class="index-list"><slot /></div>
</section>
<style>
  .collection-index { padding: 36px 0 70px; }
  .index-kicker { margin: 0; font: 10px var(--mono); letter-spacing: .1em; color: var(--muted); }
  .index-heading { display:flex; align-items:baseline; justify-content:space-between; gap:20px; margin:0 0 22px; }
  .index-count { flex-shrink:0; margin:0; color:var(--muted); font-size:11px; }
  .index-toolbar { display:flex; justify-content:space-between; gap:16px; padding:14px 0; border-bottom:1px solid var(--line); font-size:11px; }
  .index-list :global(.index-entry) { display:grid; grid-template-columns:90px minmax(0,1fr) 30px; align-items:start; gap:24px; padding:32px 0; border-bottom:1px solid var(--line); }
  .index-list :global(.entry-number) { font:44px/1 var(--mono); color:#8f7b69; letter-spacing:-.08em; }
  .index-list :global(.entry-meta) { font:10px var(--mono); color:var(--muted); }
  .index-list :global(h2) { margin:12px 0; font-size:clamp(21px,3vw,30px); letter-spacing:-.04em; line-height:1.4; }
  .index-list :global(.entry-description) { max-width:650px; margin:12px 0; color:var(--muted); font-size:13px; line-height:1.9; }
  .index-list :global(.entry-category) { color:var(--green); font-size:10px; }
  .index-list :global(.entry-arrow) { justify-self:end; font-size:24px; }
  .index-list :global(.index-entry:hover h2), .index-list :global(.index-entry:hover .entry-arrow) { color:var(--green); }
  .index-list :global(.empty-state) { padding:24px 0; color:var(--muted); font-size:13px; }
  @media(max-width:600px) { .collection-index { padding-top:28px; } .index-list :global(.index-entry) { grid-template-columns:40px minmax(0,1fr) 16px; gap:12px; padding:26px 0; } .index-list :global(.entry-number) { font-size:28px; } .index-list :global(.entry-arrow) { font-size:18px; } }
</style>
