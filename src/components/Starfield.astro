---
const stars = Array.from({length:180}, (_,i) => ({x:(i*137.508)%1600,y:(i*i*17.31)%1000,r: .5+(i%5)*.3,delay:-(i%13),duration:3+i%7}));
---
<div id="starfield" aria-hidden="true">
  <svg class="fallback-sky" viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice">
    <defs><radialGradient id="nebula"><stop stop-color="#a45537" stop-opacity=".22"/><stop offset="1" stop-color="#151412" stop-opacity="0"/></radialGradient></defs>
    <ellipse cx="1100" cy="450" rx="700" ry="500" fill="url(#nebula)" />
    <g>{stars.map(s=><circle cx={s.x} cy={s.y} r={s.r} fill="#f4e5cd" style={`--delay:${s.delay}s;--duration:${s.duration}s`} />)}</g>
  </svg>
</div>
<style>
  #starfield { position: fixed; inset: 0; z-index: 0; background: radial-gradient(ellipse at 75% 45%, #3b282022, transparent 65%), #151412; pointer-events: none; }
  .fallback-sky { width:100%; height:100%; }
  .fallback-sky circle { animation: twinkle var(--duration) ease-in-out var(--delay) infinite alternate; }
  #starfield :global(canvas) { position:absolute; inset:0; width:100%; height:100%; }
  #starfield :global(canvas.ready) + .fallback-sky { visibility:hidden; }
  @keyframes twinkle { from { opacity:.2; } to { opacity: .95; } }
  @media(prefers-reduced-motion:reduce) { .fallback-sky circle { animation:none; opacity:.7; } }
</style>
<script>
  async function initStarfield() {
    const container = document.getElementById('starfield');
    if (!container || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    let dispose = () => {};
    try {
      const THREE = await import('three');
      const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: false, powerPreference: 'low-power' });
      const canvas = renderer.domElement;
      container.prepend(canvas);
      renderer.setPixelRatio(Math.min(devicePixelRatio, 1.5));
      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(65,1,.1,100);
      camera.position.z = 7;
      const geometry = new THREE.BufferGeometry();
      const positions = new Float32Array(2600*3);
      const colors = new Float32Array(2600*3);
      for(let i=0;i<2600;i++) {
        positions[i*3]=(Math.random()-.5)*65;
        positions[i*3+1]=(Math.random()-.5)*40;
        positions[i*3+2]=-Math.random()*65;
        const tint = new THREE.Color().setHSL(.06+Math.random()*.07,.12+Math.random()*.25,.6+Math.random()*.35);
        colors.set([tint.r,tint.g,tint.b],i*3);
      }
      geometry.setAttribute('position',new THREE.BufferAttribute(positions,3));
      geometry.setAttribute('color',new THREE.BufferAttribute(colors,3));
      const material = new THREE.ShaderMaterial({
        vertexColors:true, transparent:true, depthWrite:false, blending:THREE.AdditiveBlending,
        uniforms:{pixelRatio:{value:renderer.getPixelRatio()}},
        vertexShader:`uniform float pixelRatio; varying vec3 vColor; void main(){ vColor=color; vec4 p=modelViewMatrix*vec4(position,1.0); gl_Position=projectionMatrix*p; gl_PointSize=clamp(42.0/-p.z,1.0,4.0)*pixelRatio; }`,
        fragmentShader:`varying vec3 vColor; void main(){ float d=length(gl_PointCoord-vec2(0.5)); float a=1.0-smoothstep(0.05,0.5,d); gl_FragColor=vec4(vColor,a); }`,
      });
      const points = new THREE.Points(geometry,material);
      scene.add(points);
      let frame = 0;
      let last = 0;
      let elapsed = 0;
      let targetX = 0;
      let targetY = 0;
      const resize = () => { renderer.setSize(innerWidth,innerHeight); camera.aspect=innerWidth/innerHeight; camera.updateProjectionMatrix(); };
      const pointer = (event:PointerEvent) => { targetX=(event.clientX/innerWidth-.5)*.4; targetY=(event.clientY/innerHeight-.5)*.25; };
      const render = (time:number) => {
        elapsed += Math.min((time-last)/1000,.05); last=time;
        points.rotation.y=Math.sin(elapsed*.025)*.08;
        points.rotation.z=elapsed*.003;
        camera.position.x+=(targetX-camera.position.x)*.025;
        camera.position.y+=(-targetY-camera.position.y)*.025;
        renderer.render(scene,camera);
        frame=requestAnimationFrame(render);
      };
      const visibility = () => { cancelAnimationFrame(frame); if(!document.hidden){last=performance.now();frame=requestAnimationFrame(render);} };
      const lost = (event:Event) => {event.preventDefault();dispose();};
      dispose = () => {
        cancelAnimationFrame(frame);
        removeEventListener('resize',resize); removeEventListener('pointermove',pointer);
        document.removeEventListener('visibilitychange',visibility);
        canvas.removeEventListener('webglcontextlost',lost);
        canvas.remove(); geometry.dispose(); material.dispose(); renderer.dispose();
      };
      resize(); renderer.render(scene,camera); canvas.classList.add('ready');
      addEventListener('resize',resize); addEventListener('pointermove',pointer,{passive:true});
      document.addEventListener('visibilitychange',visibility); canvas.addEventListener('webglcontextlost',lost);
      addEventListener('pagehide',dispose,{once:true});
      last=performance.now(); frame=requestAnimationFrame(render);
    } catch { dispose(); /* SVG remains visible when WebGL is unavailable. */ }
  }
  initStarfield();
</script>
