---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { collectTopics, topicPath } from '../lib/topics';
const posts = await getCollection('posts');
const topics = collectTopics(posts);
---
<BaseLayout title="关于" description="关于无趣，以及博客的专题与联系方式。">
  <section class="about-page" aria-label="关于">
    <header class="about-heading">
      <p class="kicker">关于</p>
    </header>
    <div class="about-grid">
      <section class="identity" aria-labelledby="author-name">
        <img src="/img/avator.jpg" alt="无趣的头像" width="80" height="80" />
        <h2 id="author-name">无趣</h2>
        <p>记录技术学习与实践。</p>
        <a class="github-link" href="https://github.com/wu-qu-9527" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        <dl class="statistics"><div><dt>文章</dt><dd>{String(posts.length).padStart(2,'0')}</dd></div><div><dt>专题</dt><dd>{String(topics.length).padStart(2,'0')}</dd></div></dl>
      </section>
      <div class="about-details">
        <section class="detail-section" aria-labelledby="contact-title">
          <h2 id="contact-title">联系方式</h2>
          <a class="contact-row" href="https://github.com/wu-qu-9527" target="_blank" rel="noopener noreferrer"><span>GitHub</span><strong>wu-qu-9527</strong><span aria-hidden="true">↗</span></a>
        </section>
        {topics.length > 0 && <section class="detail-section" aria-labelledby="topics-title">
          <h2 id="topics-title">专题</h2>
          <div class="topic-links">{topics.map(topic => <a href={topicPath(topic.slug)}><span>{topic.title}</span><span class="topic-count">{topic.posts.length} 篇 <i aria-hidden="true">↗</i></span></a>)}</div>
        </section>}
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .about-page { padding:36px 0 70px; }
  .kicker { margin:0; color:var(--muted); font:10px var(--mono); letter-spacing:.1em; }
  .about-grid { display:grid; grid-template-columns:260px minmax(0,1fr); gap:64px; padding-top:32px; }
  .identity img { border-radius:50%; object-fit:cover; border:1px solid var(--line); }
  .identity h2 { margin:18px 0 8px; font-size:24px; }
  .identity p { margin:0; color:var(--muted); font-size:13px; line-height:1.9; }
  .github-link { display:inline-flex; gap:30px; padding:10px 0; margin-top:16px; color:var(--green); font:12px var(--mono); }
  .statistics { display:flex; gap:44px; margin:24px 0 0; border-top:1px solid var(--line); padding-top:20px; }
  dt { color:var(--muted); font-size:11px; } dd { margin:8px 0 0; font:24px var(--mono); }
  .detail-section + .detail-section { margin-top:32px; }
  .detail-section h2 { margin:0 0 12px; font-size:15px; font-weight:500; }
  .contact-row { display:grid; grid-template-columns:90px minmax(0,1fr) 20px; gap:16px; align-items:center; padding:18px 0; border-top:1px solid var(--line); border-bottom:1px solid var(--line); font-size:13px; }
  .contact-row > span:first-child { color:var(--muted); font:11px var(--mono); }
  .contact-row strong { font-weight:400; overflow-wrap:anywhere; }
  .topic-links { border-top:1px solid var(--line); }
  .topic-links a { display:flex; justify-content:space-between; gap:16px; padding:17px 0; border-bottom:1px solid var(--line); font-size:13px; }
  .topic-count { flex-shrink:0; color:var(--muted); font-size:11px; }
  .topic-count i { margin-left:16px; font-style:normal; }
  @media(max-width:700px) { .about-page { padding-top:28px; } .about-grid { grid-template-columns:1fr; gap:32px; } .identity { display:grid; grid-template-columns:64px minmax(0,1fr); column-gap:20px; align-items:center; } .identity img { width:64px; height:64px; grid-row:1/3; } .identity h2 { margin:0; } .identity .github-link,.identity .statistics { grid-column:1/-1; } .contact-row { grid-template-columns:64px minmax(0,1fr) 16px; gap:12px; } }
</style>
