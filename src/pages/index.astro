---
import BaseLayout from '../layouts/BaseLayout.astro';
import Starfield from '../components/Starfield.astro';
---
<BaseLayout title="首页" immersive>
  <Starfield />
  <section class="space-intro">

    <h1>保持好奇。<br /><span>向未知出发。</span></h1>
    <p class="space-description">在代码与星光之间，记录每一次探索。</p>
    <a class="space-action" href="/articles/">阅读我的笔记 <span aria-hidden="true">↗</span></a>
  </section>

</BaseLayout>
<style>
  .space-intro { position: relative; z-index: 1; padding: clamp(110px, 19vh, 220px) 0 120px; pointer-events: none; }
  .space-kicker { font: 10px var(--mono); letter-spacing: .19em; color: #b7aa99; }
  h1 { margin: 32px 0 22px; font-size: clamp(48px, 7vw, 96px); font-weight: 700; line-height: 1.2; letter-spacing: -.065em; }
  h1 span { color: #df7561; }
  .space-description { color: #bcb2a5; font-size: 14px; letter-spacing: .1em; }
  .space-action { pointer-events: auto; display: inline-flex; gap: 46px; align-items: center; margin-top: 32px; padding: 16px 22px; background: #c64130; color: white; font-size: 13px; }
  .space-action:hover { background: #df543f; color: white; }
  .space-caption { position: relative; z-index: 1; display: flex; justify-content: space-between; padding-bottom: 28px; color: #a29788; font: 9px var(--mono); letter-spacing: .1em; }
  @media(max-width:600px) { .space-caption span:last-child { display: none; } }
</style>
