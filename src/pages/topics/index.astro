---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CollectionIndex from '../../components/CollectionIndex.astro';
import { collectTopics, topicPath } from '../../lib/topics';
const topics = collectTopics(await getCollection('posts'));
---
<BaseLayout title="专题" description="按专题整理的文章与学习系列。">
  <CollectionIndex title="专题" kicker="专题" count={`${String(topics.length).padStart(2,'0')} 个专题`} label="专题索引" link="/articles/" linkLabel="查看全部文章">
    {topics.map((topic,index) => <a class="index-entry" href={topicPath(topic.slug)}>
      <span class="entry-number">{String(index+1).padStart(2,'0')}</span>
      <div>
        <span class="entry-meta">{String(topic.posts.length).padStart(2,'0')} 篇文章</span>
        <h2>{topic.title}</h2>
        <p class="entry-description">{topic.description ?? '围绕这个主题持续记录与整理。'}</p>
        <span class="entry-category">专题系列</span>
      </div>
      <span class="entry-arrow" aria-hidden="true">↗</span>
    </a>)}
    {!topics.length && <p class="empty-state">专题正在整理中。</p>}
  </CollectionIndex>
</BaseLayout>
